FROM golang:1.26-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/ingestion-api ./cmd/ingestion-api

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /out/ingestion-api /ingestion-api

EXPOSE 8080

ENTRYPOINT ["/ingestion-api"]
