APP_PORT=8080
APP_ENV=development
LOG_LEVEL=info
APP_READ_TIMEOUT=5s
APP_WRITE_TIMEOUT=10s
APP_SHUTDOWN_TIMEOUT=15s

DATABASE_URL=postgres://eventpulse:eventpulse@localhost:5433/eventpulse?sslmode=disable
REDIS_URL=redis://localhost:6379

DB_MAX_CONNS=25
DB_MIN_CONNS=5
WORKER_CONCURRENCY=5
METRICS_PORT=8081

# Webhook delivery — REQUIRED; generate with: openssl rand -hex 32
WEBHOOK_SECRET_KEY=
WEBHOOK_POLL_INTERVAL=1s
WEBHOOK_BATCH_SIZE=50
WEBHOOK_HTTP_TIMEOUT=10s
WEBHOOK_ALLOW_HTTP=false

# Distributed tracing — leave empty to disable (no-op tracer)
OTEL_EXPORTER_OTLP_ENDPOINT=
